index 0000000..7a99caf
--- /dev/null
+++ b/server/src/services/session.service.ts
@@ -0,0 +1,47 @@
+import { createHash, randomUUID } from 'node:crypto';
+import type { Prisma } from '@prisma/client';
+import { prisma } from '../config/prisma.js';
+import { signAccessToken, verifyAccessToken, type AccessTokenPayload } from '../utils/tokens.js';
+
+type SessionStore = Pick<Prisma.TransactionClient, 'authSession'>;
+const sessionId = (jti: string) => createHash('sha256').update(jti).digest('hex');
+
+export const createAccessSession = async (identity: AccessTokenPayload, database: SessionStore = prisma) => {
+  const jti = randomUUID();
+  const token = signAccessToken({ ...identity, jti });
+  const claims = verifyAccessToken(token);
+  if (!claims.exp || !Number.isFinite(claims.exp)) throw new Error('Session expiration is required');
+  await database.authSession.create({ data: { id: sessionId(jti), userId: identity.sub, expiresAt: new Date(claims.exp * 1000) } });
+  return token;
+};
+
+export const revokeAccessSession = async (token: string | undefined) => {
+  if (!token) return;
+  let claims: AccessTokenPayload;
+  try { claims = verifyAccessToken(token); } catch { return; }
+  if (typeof claims.jti !== 'string' || typeof claims.sub !== 'string') return;
+  await prisma.authSession.updateMany({ where: { id: sessionId(claims.jti), userId: claims.sub, revokedAt: null }, data: { revokedAt: new Date() } });
+};
+
+export const revokeUserSessions = (userId: string, database: SessionStore) => database.authSession.updateMany({
+  where: { userId, revokedAt: null }, data: { revokedAt: new Date() }
+});
+
+export const authenticateToken = async (token: string): Promise<AccessTokenPayload | null> => {
+  let claims: AccessTokenPayload;
+  try { claims = verifyAccessToken(token); } catch { return null; }
+  // Legacy stateless tokens intentionally require one-time sign-in after rollout.
+  if (typeof claims.sub !== 'string' || typeof claims.jti !== 'string' || !claims.jti) return null;
+  const session = await prisma.authSession.findUnique({ where: { id: sessionId(claims.jti) }, select: { userId: true, expiresAt: true, revokedAt: true } });
+  if (!session || session.userId !== claims.sub || session.revokedAt || session.expiresAt <= new Date()) return null;
+  const user = await prisma.user.findUnique({
+    where: { id: claims.sub },
+    select: { id: true, role: true, email: true, displayName: true,
+      employeeProfile: { select: { status: true, dateOfRelieving: true } } }
+  });
+  if (!user || !['ADMIN', 'EMPLOYEE', 'AGENT', 'CUSTOMER'].includes(user.role)) return null;
+  const profile = user.employeeProfile;
+  if (user.role === 'EMPLOYEE' && (profile?.status === 'FROZEN' ||
+    (profile?.dateOfRelieving && profile.dateOfRelieving <= new Date()))) return null;
+  return { sub: user.id, role: user.role, email: user.email, displayName: user.displayName, jti: claims.jti, exp: claims.exp };
+};
