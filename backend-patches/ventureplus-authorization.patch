diff --git a/server/src/services/access.service.ts b/server/src/services/access.service.ts
new file mode 100644
index 0000000..185ad3f
--- /dev/null
+++ b/server/src/services/access.service.ts
@@ -0,0 +1,91 @@
+import type { Prisma } from "@prisma/client";
+import { prisma } from "../config/prisma.js";
+import { HttpError } from "../utils/httpError.js";
+import { getEmployeeAssignment } from "./employeeAssignment.service.js";
+
+export interface Requester {
+  userId?: string;
+  role?: string;
+  email?: string;
+  displayName?: string;
+}
+
+export const requireRequester = (requester?: Requester): Requester => {
+  if (!requester?.userId) throw new HttpError(401, "Authentication required");
+  if (!["ADMIN", "EMPLOYEE", "AGENT", "CUSTOMER"].includes(requester.role ?? "")) {
+    throw new HttpError(403, "Insufficient permissions");
+  }
+  return requester;
+};
+
+export const plotAccessWhere = async (requester?: Requester): Promise<Prisma.PlotWhereInput> => {
+  const actor = requireRequester(requester);
+  if (actor.role === "CUSTOMER") {
+    return actor.email ? { leads: { some: { email: actor.email } } } : { id: { in: [] } };
+  }
+  if (actor.role === "EMPLOYEE") {
+    const assignment = await getEmployeeAssignment(actor.userId!);
+    return { venture: { OR: [
+      { id: { in: assignment.assignedVentureIds } },
+      { locationId: { in: assignment.assignedLocationIds } }
+    ] } };
+  }
+  return {};
+};
+
+export const assertPlotAccess = async (plotId: string, requester?: Requester) => {
+  const scope = await plotAccessWhere(requester);
+  const plot = await prisma.plot.findFirst({ where: { id: plotId, AND: [scope] }, select: { id: true } });
+  if (!plot) throw new HttpError(404, "Plot not found");
+};
+
+export const hasCustomerEmail = (notes: string | null, email: string) => {
+  // Legacy records encode ownership as a dedicated line; incidental text grants nothing.
+  const expected = email.trim().toLowerCase();
+  const ownerLines = (notes ?? "").split(/\r?\n/).map(line => line.trim()).filter(line => /^Email:/i.test(line));
+  if (!expected || ownerLines.length !== 1) return false;
+  const match = /^Email:\s*(\S+)\s*$/i.exec(ownerLines[0]);
+  return match?.[1].toLowerCase() === expected;
+};
+
+export const employeeOwnerAliases = async (requester: Requester): Promise<string[]> => {
+  const me = await prisma.user.findUnique({
+    where: { id: requester.userId! },
+    select: { email: true, fullName: true, displayName: true, employeeId: true }
+  });
+  if (!me) return [];
+  const aliases = [...new Set([me.email, me.fullName, me.displayName, me.employeeId].filter((v): v is string => Boolean(v?.trim())).map(v => v.trim()))];
+  const unambiguous: string[] = [];
+  for (const alias of aliases) {
+    const others = await prisma.user.count({ where: { id: { not: requester.userId }, OR: [
+      { email: alias }, { fullName: alias }, { displayName: alias }, { employeeId: alias }
+    ] } });
+    if (!others) unambiguous.push(alias);
+  }
+  return unambiguous;
+};
+
+export const recordAccessWhere = async (requester?: Requester): Promise<Prisma.CustomerRecordWhereInput> => {
+  const actor = requireRequester(requester);
+  if (actor.role === "CUSTOMER") {
+    if (!actor.email) return { id: { in: [] } };
+    // shortcut: legacy notes need exact parsing, replace with a durable customer FK in a reviewed migration.
+    const candidates = await prisma.customerRecord.findMany({
+      where: { notes: { contains: actor.email } }, select: { id: true, notes: true }
+    });
+    // Keep the ownership-bearing value in the final query too, so a concurrent
+    // edit cannot turn an earlier candidate into an authorized foreign record.
+    return { OR: candidates.filter(row => hasCustomerEmail(row.notes, actor.email!)).map(row => ({ id: row.id, notes: row.notes })) };
+  }
+  if (actor.role === "EMPLOYEE") {
+    const aliases = await employeeOwnerAliases(actor);
+    return { OR: [{ recordOwner: { in: aliases } }, { leadName: { in: aliases } }] };
+  }
+  return {};
+};
+
+export const assertRecordAccess = async (id: string, requester?: Requester) => {
+  const scope = await recordAccessWhere(requester);
+  const record = await prisma.customerRecord.findFirst({ where: { id, AND: [scope] }, select: { id: true } });
+  if (!record) throw new HttpError(404, "Customer record not found");
+};
