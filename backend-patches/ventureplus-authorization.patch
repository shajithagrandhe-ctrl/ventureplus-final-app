@@ -0,0 +1,11 @@
+const isOwnershipLine = (line: string) => /^Email:/i.test(line.trim());
+
+export const stripCustomerEmailLines = (notes: string) =>
+  notes.split(/\r?\n/).filter(line => !isOwnershipLine(line)).join("\n");
+
+export const preserveCustomerEmailLines = (notes: string, existingNotes: string | null) => {
+  // Free-text edits cannot create, transfer or remove the legacy access key.
+  // Preserve ambiguous legacy headers as-is so editing notes cannot grant access.
+  const ownership = (existingNotes ?? "").split(/\r?\n/).filter(isOwnershipLine);
+  return [...ownership, stripCustomerEmailLines(notes)].join("\n");
+};
