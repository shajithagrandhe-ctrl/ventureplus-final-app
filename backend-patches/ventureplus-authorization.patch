+test('request logging redacts authorization, cookies and CSRF values while retaining diagnostics', () => {
+  let output = '';
+  const logger = pino({ ...loggerOptions, level: 'info' }, { write: text => { output += text; } });
+  logger.info({ req: { method: 'GET', url: '/api/me', headers: { authorization: 'synthetic-bearer-secret', cookie: 'synthetic-cookie-secret', 'x-csrf-token': 'synthetic-csrf-secret' } }, res: { statusCode: 200, headers: { 'set-cookie': ['synthetic-response-secret'] } } }, 'request completed');
