diff --git a/backend/gateway.test.mjs b/backend/gateway.test.mjs
new file mode 100644
index 0000000..0a95d85
--- /dev/null
+++ b/backend/gateway.test.mjs
@@ -0,0 +1,67 @@
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { createServer, request } from 'node:http';
+import app from './index.mjs';
+
+let gateway, upstream, gatewayPort, upstreamPort;
+let received = [];
+const previousBinding = process.env.SERVER_INTERNAL_URL;
+const listen = server => new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+before(async () => {
+  upstream = createServer((req, res) => {
+    const chunks = [];
+    req.on('data', chunk => chunks.push(chunk));
+    req.on('end', () => {
+      received.push({ path: req.url, method: req.method, body: Buffer.concat(chunks).toString(), forwardedHost: req.headers['x-forwarded-host'] });
+      res.writeHead(201, { 'content-type': 'application/json', 'set-cookie': 'synthetic=fixture; HttpOnly' });
+      res.end(JSON.stringify({ success: true }));
+    });
+  });
+  await listen(upstream);
+  upstreamPort = upstream.address().port;
+  process.env.SERVER_INTERNAL_URL = `http://127.0.0.1:${upstreamPort}`;
+  gateway = createServer(app);
+  await listen(gateway);
+  gatewayPort = gateway.address().port;
+});
+after(async () => {
+  if (previousBinding === undefined) delete process.env.SERVER_INTERNAL_URL;
+  else process.env.SERVER_INTERNAL_URL = previousBinding;
+  for (const server of [gateway, upstream]) {
+    server.closeAllConnections();
+    await new Promise(resolve => server.close(resolve));
+  }
+});
+const call = (path, body = '') => new Promise((resolve, reject) => {
+  const req = request({ hostname: '127.0.0.1', port: gatewayPort, path, method: body ? 'POST' : 'GET' }, res => {
+    const chunks = [];
+    res.on('data', chunk => chunks.push(chunk));
+    res.on('end', () => resolve({ status: res.statusCode, headers: res.headers, body: Buffer.concat(chunks).toString() }));
+  });
+  req.on('error', reject);
+  req.end(body);
+});
+test('gateway preserves the configured service path, query, body, status and cookie', async () => {
+  const response = await call('/api/example?filter=one', 'synthetic fixture');
+  assert.equal(response.status, 201);
+  assert.match(response.headers['set-cookie'][0], /synthetic=fixture/);
+  assert.deepEqual(received.at(-1), { path: '/api/example?filter=one', method: 'POST', body: 'synthetic fixture', forwardedHost: `127.0.0.1:${gatewayPort}` });
+});
+test('absolute, protocol-relative and backslash request targets cannot select another upstream', async () => {
+  const initial = received.length;
+  for (const path of [`//127.0.0.1:${upstreamPort}/stolen`, `http://127.0.0.1:${upstreamPort}/stolen`, '/\\127.0.0.1/stolen']) {
+    assert.equal((await call(path)).status, 400);
+  }
+  assert.equal(received.length, initial);
+});
+test('missing, malformed and non-HTTP bindings fail closed without leaking details', async () => {
+  const initial = received.length;
+  for (const binding of ['', 'not-a-url', 'file:///sensitive', 'http://name:password@127.0.0.1']) {
+    process.env.SERVER_INTERNAL_URL = binding;
+    const response = await call('/api/example');
+    assert.equal(response.status, 503);
+    assert.doesNotMatch(response.body, /sensitive|password/);
+  }
+  assert.equal(received.length, initial);
+  process.env.SERVER_INTERNAL_URL = `http://127.0.0.1:${upstreamPort}`;
+});
