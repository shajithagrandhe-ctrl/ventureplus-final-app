index 6649afa..f274f45 100644
--- a/backend/index.mjs
+++ b/backend/index.mjs
@@ -14,7 +14,20 @@ const hopHeaders = new Set([
 app.use((req, res) => {
   const base = process.env.SERVER_INTERNAL_URL;
   if (!base) return res.status(503).json({ success: false, message: 'SERVER_INTERNAL_URL binding is missing' });
-  const target = new URL(req.originalUrl, base);
+  let target;
+  try {
+    const binding = new URL(base);
+    if (!['http:', 'https:'].includes(binding.protocol) || binding.username || binding.password) throw new Error('Invalid binding');
+    // A request target is a path, never a second upstream URL. In particular,
+    // URL('//host/path', base) must not turn this service into an open proxy.
+    if (!req.originalUrl.startsWith('/') || req.originalUrl.startsWith('//') || [...req.originalUrl].some(character => character === '\\' || character.charCodeAt(0) <= 32 || character.charCodeAt(0) === 127)) {
+      return res.status(400).json({ success: false, message: 'Invalid request path' });
+    }
+    target = new URL(req.originalUrl, binding.origin);
+    if (target.origin !== binding.origin) return res.status(400).json({ success: false, message: 'Invalid request path' });
+  } catch {
+    return res.status(503).json({ success: false, message: 'Application service binding is invalid' });
+  }
   const headers = Object.fromEntries(Object.entries(req.headers).filter(([name]) => !hopHeaders.has(name)));
   headers['x-forwarded-host'] = req.headers['x-forwarded-host'] || req.headers.host;
   headers['x-forwarded-proto'] = req.headers['x-forwarded-proto'] || req.protocol;
